# ============================================================================
# EVOLVE — copy to .env and set real values. Leave optional keys blank when unused.
# ============================================================================

APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=
APP_PORT=8501
APP_HOST=0.0.0.0

# Required for LLM features (set when using OpenAI / Anthropic)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional — news aggregator (empty = skip ExternalSignalsManager news path noise)
NEWS_API_KEY=

# Optional — Reddit authenticated API (higher limits than public JSON)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=EvolveTradingBot/1.0

# Optional — external data sources (empty = no Tradier/FRED/Twitter key-based calls)
TWITTER_API_KEY=
TWITTER_BEARER_TOKEN=
FRED_API_KEY=
TRADIER_TOKEN=
